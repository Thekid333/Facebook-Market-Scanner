# --- GitHub Gist publishing (free "view anywhere" bridge to the iOS app) ---
# 1. Create a token at https://github.com/settings/tokens
#    - Classic token with the "gist" scope is enough.
# 2. Paste it below. Leave GIST_ID blank on the FIRST run — the scraper will
#    create a secret gist and print its id; copy that id into GIST_ID here AND
#    into the app's Snipe settings.
GITHUB_TOKEN=ghp_your_token_here
GIST_ID=

# How many days a listing stays in the feed before it is pruned out.
LISTING_RETENTION_DAYS=7
